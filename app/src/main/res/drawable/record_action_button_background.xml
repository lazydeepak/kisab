<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/recordActionSelectedBackground" />
            <stroke
                android:width="2dp"
                android:color="@color/recordActionContent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/recordActionBackground" />
        </shape>
    </item>
</selector>