<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordActionSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/record_sheet_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/record_sheet_farm_output"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/recordSheetProductionButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/production_action" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/record_sheet_sales_payments"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/recordSheetSellButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/quick_sale_action" />

    <Button
        android:id="@+id/recordSheetReceivedMoneyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/received_money_action" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/record_sheet_supplies"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/recordSheetBoughtButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/supply_purchase_action" />

    <Button
        android:id="@+id/recordSheetUsedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/supply_usage_action" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/record_sheet_other_money"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/recordSheetPaidMoneyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/supplier_payment_action" />

    <Button
        android:id="@+id/recordSheetCancelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        android:text="@string/record_sheet_cancel" />
</LinearLayout>