<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kisanCalculatorToolbox"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/kisan_tools_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/kisan_tools_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/arithmetic_title"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/arithmeticFirstInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/first_number_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal|numberSigned"
        android:maxLines="1" />

    <Spinner
        android:id="@+id/arithmeticOperationSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/arithmeticSecondInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/second_number_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal|numberSigned"
        android:maxLines="1" />

    <Button
        android:id="@+id/calculateArithmeticButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/calculate_action" />

    <TextView
        android:id="@+id/arithmeticResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_metric_tile"
        android:lineSpacingMultiplier="1.15"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/profit_title"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/profitCostInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/cost_price_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <EditText
        android:id="@+id/profitRevenueInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/selling_price_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <Button
        android:id="@+id/calculateProfitButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/calculate_profit_action" />

    <TextView
        android:id="@+id/profitResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_metric_tile"
        android:lineSpacingMultiplier="1.15"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/interest_title"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/interestPrincipalInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/principal_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <EditText
        android:id="@+id/interestRateInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/annual_rate_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <EditText
        android:id="@+id/interestMonthsInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/months_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <Button
        android:id="@+id/calculateInterestButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/calculate_interest_action" />

    <TextView
        android:id="@+id/interestResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_metric_tile"
        android:lineSpacingMultiplier="1.15"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/land_converter_title"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/land_converter_body" />

    <EditText
        android:id="@+id/landValueInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/area_value_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:maxLines="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/from_unit_label" />

    <Spinner
        android:id="@+id/landFromUnitSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/to_unit_label" />

    <Spinner
        android:id="@+id/landToUnitSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/convertLandButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="@string/convert_action" />

    <TextView
        android:id="@+id/landResultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_metric_tile"
        android:lineSpacingMultiplier="1.15"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="24dp"
        android:background="#33000000" />
</LinearLayout>
