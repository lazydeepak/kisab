<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/farmPlanningContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/farm_planning_title"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/farm_planning_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/farm_planning_calculator_label"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/farmPlanningCalculatorSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="48dp" />

    <!-- Seed Calculator -->
    <LinearLayout
        android:id="@+id/seedCalculatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/seed_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/seed_body" />

        <EditText
            android:id="@+id/seedAreaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/area_value_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/land_unit_label" />

        <Spinner
            android:id="@+id/seedLandUnitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/seedRateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/seed_rate_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/seedPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/price_per_kg_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/calculateSeedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calculate_action" />

        <TextView
            android:id="@+id/seedResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Fertilizer Calculator -->
    <LinearLayout
        android:id="@+id/fertilizerCalculatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fertilizer_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fertilizer_body" />

        <EditText
            android:id="@+id/fertilizerAreaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/area_value_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/land_unit_label" />

        <Spinner
            android:id="@+id/fertilizerLandUnitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/fertilizerRateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fertilizer_rate_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/fertilizerPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/price_per_kg_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/calculateFertilizerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calculate_action" />

        <TextView
            android:id="@+id/fertilizerResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Feed Calculator -->
    <LinearLayout
        android:id="@+id/feedCalculatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feed_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/feed_body" />

        <EditText
            android:id="@+id/feedAnimalCountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/animal_count_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/feedKgPerAnimalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/kg_per_animal_per_day_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/feedDaysInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/days_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/feedPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/price_per_kg_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/calculateFeedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calculate_action" />

        <TextView
            android:id="@+id/feedResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Milk Calculator -->
    <LinearLayout
        android:id="@+id/milkCalculatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/milk_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/milk_body" />

        <EditText
            android:id="@+id/milkAnimalCountInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/milking_animal_count_hint"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLines="1" />

        <EditText
            android:id="@+id/milkLitresPerAnimalInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/litres_per_animal_per_day_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/milkDaysInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/days_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/milkPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/price_per_litre_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/calculateMilkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calculate_action" />

        <TextView
            android:id="@+id/milkResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Crop Yield Calculator -->
    <LinearLayout
        android:id="@+id/cropYieldCalculatorContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/crop_yield_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/crop_yield_body" />

        <EditText
            android:id="@+id/cropYieldAreaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/area_value_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/land_unit_label" />

        <Spinner
            android:id="@+id/cropYieldLandUnitSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/cropYieldRateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/expected_yield_rate_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <EditText
            android:id="@+id/cropYieldPriceInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/price_per_kg_hint"
            android:importantForAutofill="no"
            android:inputType="numberDecimal"
            android:maxLines="1" />

        <Button
            android:id="@+id/calculateCropYieldButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/calculate_action" />

        <TextView
            android:id="@+id/cropYieldResultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="24dp"
        android:background="#33000000" />
</LinearLayout>